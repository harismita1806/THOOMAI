FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt* ./
RUN pip install --no-cache-dir fastapi uvicorn pydantic pydantic-settings sqlalchemy httpx scikit-learn xgboost paho-mqtt pandas numpy

COPY backend/ .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
